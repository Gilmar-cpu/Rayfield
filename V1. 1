-- Auto Collect Orbs
local collecting = false
local player = game.Players.LocalPlayer

local function autoCollect()
    while collecting do
        local char = player.Character or player.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")

        for _, v in pairs(workspace.orbFolder.City:GetChildren()) do
            if v:IsA("MeshPart") then
                firetouchinterest(hrp, v, 0)
                firetouchinterest(hrp, v, 1)
            elseif v:IsA("Model") then
                local gem = v:FindFirstChildWhichIsA("BasePart")
                if gem then
                    firetouchinterest(hrp, gem, 0)
                    firetouchinterest(hrp, gem, 1)
                end
            end
        end

        task.wait(0.2)
    end
end

MainTab:CreateToggle({
    Name = "Auto Collect Orbs",
    CurrentValue = false,
    Flag = "AutoCollectToggle",
    Callback = function(state)
        collecting = state
        if collecting then
            spawn(autoCollect)
        end
    end
})

-- Auto Hatch & Manual Hatch
local hatching = false
local remote = game:GetService("ReplicatedStorage").rEvents:FindFirstChild("openCrystalRemote")

-- Auto Hatch Toggle (corrigido)
MainTab:CreateToggle({
    Name = "Auto Hatch Red Crystal",
    CurrentValue = false,
    Flag = "AutoHatchToggle",
    Callback = function(state)
        hatching = state
        if hatching then
            task.spawn(function()
                while hatching do
                    pcall(function()
                        remote:InvokeServer("openCrystal", "Red Crystal")
                    end)
                    task.wait(0.3)
                end
            end)
        end
    end
})           enden        ene

MainTab:CreateButton({
    Name = "Open 1 Red Crystal",
    Callback = function()
        pcall(function()
            remote:InvokeServer("openCrystal", "Red Crystal")
        end)
    end
})

